pipeline {
    agent any
    
    environment {
        PROJECT_DIR = "${env.WORKSPACE}/frontend"
        BUILD_DIR = "${PROJECT_DIR}/build"
        DEPLOY_DIR = "/var/www/html"
        FRONTEND_CHANGED = 'false'
        BUILD_TAG = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('🔍 변경사항 감지') {
            steps {
                script {
                    echo "=== 프론트엔드 변경 감지 중 ==="
                    
                    def changes = []
                    def frontendChanged = false
                    
                    try {
                        changes = sh(
                            script: "git diff --name-only HEAD~1 HEAD || git ls-files",
                            returnStdout: true
                        ).trim().split('\n')
                    } catch(Exception e) {
                        echo "첫 빌드이거나 diff 실패: ${e.getMessage()}"
                        changes = sh(
                            script: "git ls-files",
                            returnStdout: true
                        ).trim().split('\n')
                    }
                    
                    echo "변경된 파일들:"
                    changes.each { file ->
                        echo "  - ${file}"
                        if (file.startsWith('frontend/') && !file.endsWith('Jenkinsfile')) {
                            frontendChanged = true
                            echo "    → 프론트엔드 변경 감지"
                        }
                    }
                    
                    // 환경변수 설정
                    env.FRONTEND_CHANGED = frontendChanged ? 'true' : 'false'
                    
                    echo """
=== 빌드 계획 ===
프론트엔드 빌드: ${env.FRONTEND_CHANGED}
빌드 번호: ${BUILD_TAG}
                    """
                }
            }
        }
        
        stage('💻 Install & Build') {
            when {
                environment name: 'FRONTEND_CHANGED', value: 'true'
            }
            steps {
                echo '=== 프론트엔드 빌드 중 ==='
                sh """
                    cd ${PROJECT_DIR}
                    
                    echo "Node.js 버전 확인:"
                    node --version
                    npm --version
                    
                    echo "의존성 설치 중..."
                    npm ci
                    
                    echo "프로덕션 빌드 중..."
                    npm run build
                    
                    echo "빌드 결과 확인:"
                    ls -la ${BUILD_DIR}/
                """
                echo '✅ 프론트엔드 빌드 완료'
            }
        }
        
        stage('🚀 배포') {
            when {
                expression {
                    return env.FRONTEND_CHANGED == 'true'
                }
            }
            steps {
                echo '=== 프론트엔드 배포 중 ==='
                sh """
                    echo "기존 파일 백업..."
                    sudo cp -r ${DEPLOY_DIR} ${DEPLOY_DIR}.backup.${BUILD_TAG} || true
                    
                    echo "새 파일 배포..."
                    sudo rsync -avz --delete ${BUILD_DIR}/ ${DEPLOY_DIR}/
                    
                    echo "파일 권한 설정..."
                    sudo chown -R www-data:www-data ${DEPLOY_DIR}
                    sudo chmod -R 755 ${DEPLOY_DIR}
                    
                    echo "nginx 재시작..."
                    sudo systemctl restart nginx
                    
                    echo "배포된 파일 확인:"
                    ls -la ${DEPLOY_DIR}/
                """
                echo '✅ 프론트엔드 배포 완료'
            }
        }
        
        stage('🏥 헬스체크') {
            when {
                expression {
                    return env.FRONTEND_CHANGED == 'true'
                }
            }
            steps {
                echo '=== 웹사이트 헬스체크 ==='
                sh '''
                    echo "nginx 상태 확인..."
                    sudo systemctl status nginx --no-pager
                    
                    echo "웹사이트 접근 테스트..."
                    sleep 5
                    
                    for i in {1..5}; do
                        if curl -f -s http://localhost > /dev/null; then
                            echo "✅ 웹사이트가 정상적으로 응답합니다 ($i/5)"
                            break
                        fi
                        echo "⏳ 웹사이트 응답 대기 중... ($i/5)"
                        sleep 3
                    done
                '''
            }
        }
    }
    
    post {
        success {
            script {
                if (env.FRONTEND_CHANGED == 'true') {
                    echo """
🎉 프론트엔드 배포 성공!
빌드 번호: ${BUILD_NUMBER}
배포 위치: ${DEPLOY_DIR}

웹사이트 확인: http://13.125.20.43
                    """
                } else {
                    echo '프론트엔드 변경사항이 없어 배포하지 않았습니다.'
                }
            }
        }
        
        failure {
            echo '''
❌ 프론트엔드 배포 실패!

일반적인 해결 방법:
1. 빌드 오류: npm run build 직접 실행해보기
2. 권한 오류: sudo 권한 확인
3. nginx 오류: sudo systemctl status nginx 확인
4. 디스크 용량: df -h 로 용량 확인
            '''
            
            // 실패 시 백업에서 복구
            sh '''
                if [ -d "${DEPLOY_DIR}.backup.${BUILD_TAG}" ]; then
                    echo "백업에서 복구 중..."
                    sudo cp -r ${DEPLOY_DIR}.backup.${BUILD_TAG}/* ${DEPLOY_DIR}/ || true
                    sudo systemctl restart nginx || true
                fi
            '''
        }
        
        always {
            echo '=== 정리 작업 ==='
            sh '''
                echo "오래된 백업 파일 정리 (7일 이상)..."
                find /var/www/ -name "html.backup.*" -mtime +7 -exec sudo rm -rf {} + || true
                
                echo "디스크 사용량 확인:"
                df -h
                
                echo "nginx 프로세스 확인:"
                ps aux | grep nginx | head -5
            '''
        }
    }
}